# Optional. Both settings are unset in the demo build and the app runs without them.

# Backend endpoint for the offline sync queue. When set, queued writes are POSTed
# to ${NEXT_PUBLIC_API_BASE}/sync instead of completing against a simulated round-trip.
# NEXT_PUBLIC_API_BASE=https://api.lc-deped.example/v1

# VAPID public key for real Web Push subscriptions. Without it, gate alerts are
# shown as local service-worker notifications.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
