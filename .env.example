# Optional. Both settings are unset in the demo build and the app runs without them.

# Backend endpoint for the offline sync queue. When set, queued writes are POSTed
# to ${NEXT_PUBLIC_API_BASE}/sync instead of completing against a simulated round-trip.
# NEXT_PUBLIC_API_BASE=https://api.lc-deped.example/v1

# VAPID public key for real Web Push subscriptions. Without it, gate alerts are
# shown as local service-worker notifications.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- LIS transmittal ---------------------------------------------------
# Postgres project that records LIS transmittal receipts. Without these the
# LIS page validates the roster and produces the upload file, but says the
# store is unavailable and records nothing.
# On Vercel, set these for the Production environment and then redeploy --
# environment variables are bound to a deployment when it is built, so an
# existing deployment will not pick them up.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# A service-role key is preferred where one is available; it takes priority.
# SUPABASE_SERVICE_ROLE_KEY=

# DepEd LIS enrolment endpoint. Without it a batch is validated and recorded
# but not transmitted, and the receipt says so rather than claiming a send.
# LIS_API_BASE=https://lis.deped.gov.ph/api/v1
# LIS_API_KEY=
